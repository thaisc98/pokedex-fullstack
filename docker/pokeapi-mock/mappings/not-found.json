{
  "mappings": [
    {
      "name": "not recorded: PokeAPI 404",
      "priority": 10,
      "request": {
        "method": "ANY",
        "urlPattern": "/.*"
      },
      "response": {
        "status": 404,
        "headers": {
          "Content-Type": "application/json; charset=utf-8"
        },
        "bodyFileName": "errors/not-found.json"
      }
    }
  ]
}
