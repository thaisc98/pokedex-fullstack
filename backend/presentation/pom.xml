<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.pokedex</groupId>
        <artifactId>pokedex-backend</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>pokedex-presentation</artifactId>
    <name>pokedex-presentation</name>

    <properties>
        <!-- JaCoCo gate (testing-strategy §3). -->
        <coverage.line.min>0.85</coverage.line.min>
        <coverage.branch.min>0.80</coverage.branch.min>
    </properties>
    <description>REST controllers, request/response DTOs, error handler, SecurityFilterChain.
                 Depends on application; must never depend on infrastructure.</description>

    <dependencies>
        <dependency>
            <groupId>com.pokedex</groupId>
            <artifactId>pokedex-application</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Boot 4 renamed the web starter: webmvc, not web (AGENTS.md outdated-API list). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <!-- SecurityFilterChain: deny by default, stateless, CSRF on (security.md §3-4). Boot-managed. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
        </dependency>
        <!-- OpenAPI docs + Swagger UI. Disabled by default; enabled only in the demo profile (security.md §3.2). -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Boot 4 split the slice-test annotations into per-technology jars; @WebMvcTest is no longer
             transitive via starter-test (package: org.springframework.boot.webmvc.test.autoconfigure). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Boot 4: spring-security-test + the security auto-config for @WebMvcTest slices. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- StubPokemonCatalog / in-memory fakes. -->
        <dependency>
            <groupId>com.pokedex</groupId>
            <artifactId>pokedex-application</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
