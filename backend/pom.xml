<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>com.pokedex</groupId>
    <artifactId>pokedex-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>pokedex-backend</name>
    <description>Pokédex backend — Clean Architecture multi-module build (Java 25 / Spring Boot 4.1.1)</description>

    <modules>
        <module>domain</module>
        <module>application</module>
        <module>infrastructure</module>
        <module>presentation</module>
        <module>bootstrap</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Tool versions verified against Maven Central, 2026-10. Surefire/Failsafe/Enforcer
             are managed by the Boot 4.1.1 parent; these are the ones the parent does not pin. -->
        <jacoco.version>0.8.15</jacoco.version>
        <pitest.version>1.30.1</pitest.version>
        <pitest-junit5.version>1.2.3</pitest-junit5.version>
        <spotless.version>3.10.4</spotless.version>
        <palantir.version>2.102.0</palantir.version>
        <archunit.version>1.5.1</archunit.version>
        <jspecify.version>1.0.1</jspecify.version>
        <!-- springdoc-openapi 3.x is the Spring Boot 4 line (springdoc.org FAQ "compatibility matrix");
             3.1.0 moved to Boot 4.1.0. 3.1.1 = <release> on Maven Central, verified 2026-10-20. -->
        <springdoc.version>3.1.1</springdoc.version>

        <!-- JaCoCo gate defaults; domain/application/presentation/infrastructure override them. -->
        <coverage.line.min>0.00</coverage.line.min>
        <coverage.branch.min>0.00</coverage.branch.min>

        <!-- Test-only, used by the bootstrap acceptance ITs (approved for US01). -->
        <wiremock.version>3.13.2</wiremock.version>
        <rest-assured.version>6.2.0</rest-assured.version>

        <!-- Rate limiting (security.md §4.1 names Bucket4j). Not managed by Boot; 8.21.0 = <release> of
             com.bucket4j:bucket4j_jdk17-core on Maven Central, verified 2026-10-21. -->
        <bucket4j.version>8.21.0</bucket4j.version>

        <!-- Supply-chain security tooling (-Psecurity only; see security.md §4.10). Versions are the
             latest releases on Maven Central, verified 2026-10-20:
             cyclonedx-maven-plugin <release>=2.9.3, dependency-check-maven <release>=13.0.0. -->
        <cyclonedx.version>2.9.3</cyclonedx.version>
        <dependency-check.version>13.0.0</dependency-check.version>

        <!-- CVE override: Spring Boot 4.1.1 manages tomcat-embed-core 11.0.24, which Dependency-Check
             flags for the following CVEs (CVSS 7.5–9.8), fixed upstream in 11.0.25:
             CVE-2026-65905, CVE-2026-65637, CVE-2026-68525, CVE-2026-65182, CVE-2026-65183,
             CVE-2026-65927, CVE-2026-66422, CVE-2026-68569, CVE-2026-68763, CVE-2026-73180,
             CVE-2026-66299.
             11.0.27 is the latest 11.0.x on Maven Central (<release>, verified 2026-10-20) and is >= 11.0.25.
             Remove this override once a Spring Boot release manages Tomcat >= 11.0.25. -->
        <tomcat.version>11.0.27</tomcat.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.jspecify</groupId>
                <artifactId>jspecify</artifactId>
                <version>${jspecify.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!-- Mutation testing (-Pmutation on domain + application). -->
                <plugin>
                    <groupId>org.pitest</groupId>
                    <artifactId>pitest-maven</artifactId>
                    <version>${pitest.version}</version>
                    <dependencies>
                        <dependency>
                            <groupId>org.pitest</groupId>
                            <artifactId>pitest-junit5-plugin</artifactId>
                            <version>${pitest-junit5.version}</version>
                        </dependency>
                    </dependencies>
                    <configuration>
                        <targetClasses>
                            <param>com.pokedex.*</param>
                        </targetClasses>
                        <targetTests>
                            <param>com.pokedex.*</param>
                        </targetTests>
                        <mutationThreshold>75</mutationThreshold>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- Clean Architecture guard #1: fail the build on banned deps / wrong Java / divergent versions.
                 requireJavaVersion + requireMavenVersion + dependencyConvergence apply to every module;
                 the framework ban lives in domain/pom.xml and application/pom.xml. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-build-rules</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[25,)</version>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9,)</version>
                                </requireMavenVersion>
                                <dependencyConvergence/>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Formatting: palantir-java-format. `verify` runs check; `spotless:apply` fixes. -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless.version}</version>
                <configuration>
                    <java>
                        <palantirJavaFormat>
                            <version>${palantir.version}</version>
                        </palantirJavaFormat>
                        <importOrder/>
                        <removeUnusedImports/>
                        <formatAnnotations/>
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <id>spotless-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Coverage. prepare-agent + report run in every module; report-aggregate lives in bootstrap.
                 jacoco-check enforces the per-module gates from testing-strategy §3 (see coverage.*.min). -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>jacoco-prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <!-- Per-module gates (testing-strategy §3). Each module sets coverage.line.min /
                         coverage.branch.min; the defaults here (0) leave bootstrap to its aggregate report. -->
                    <execution>
                        <id>jacoco-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${coverage.line.min}</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${coverage.branch.min}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Integration/E2E tests (*IT). Surefire (*Test) is bound by the default lifecycle; the Boot
                 parent manages Failsafe and binds integration-test + verify once the plugin is declared. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>

            <!-- Treat compiler warnings as errors (testing-strategy §3). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <failOnWarning>true</failOnWarning>
                    <compilerArgs>
                        <arg>-Xlint:all,-processing</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- `./mvnw -pl domain,application -Pmutation verify` -->
        <profile>
            <id>mutation</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <executions>
                            <execution>
                                <id>pitest-mutation-coverage</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>mutationCoverage</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- `./mvnw -Psecurity verify` — supply-chain security scan (security.md §4.10, threat T11).
             Kept out of the default build: the NVD scan is slow and needs an API key. CI runs it on a
             schedule / dedicated job. CycloneDX emits an aggregate SBOM; Dependency-Check fails on CVSS >= 7.
             The NVD API key is read from the NVD_API_KEY environment variable. -->
        <profile>
            <id>security</id>
            <build>
                <plugins>
                    <!-- SBOM (CycloneDX). makeAggregateBom runs once on the root and covers all modules. -->
                    <plugin>
                        <groupId>org.cyclonedx</groupId>
                        <artifactId>cyclonedx-maven-plugin</artifactId>
                        <version>${cyclonedx.version}</version>
                        <executions>
                            <execution>
                                <id>cyclonedx-sbom</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>makeAggregateBom</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- OWASP Dependency-Check: fail the build on any dependency CVE with CVSS >= 7.
                         The `aggregate` goal with inherited=false runs once on the root reactor and
                         produces a single report covering every module's dependencies. -->
                    <plugin>
                        <groupId>org.owasp</groupId>
                        <artifactId>dependency-check-maven</artifactId>
                        <version>${dependency-check.version}</version>
                        <inherited>false</inherited>
                        <configuration>
                            <nvdApiKey>${env.NVD_API_KEY}</nvdApiKey>
                            <failBuildOnCVSS>7</failBuildOnCVSS>
                        </configuration>
                        <executions>
                            <execution>
                                <id>dependency-check-aggregate</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>aggregate</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
