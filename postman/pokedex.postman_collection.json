{
  "info": {
    "_postman_id": "317edba0-1dff-4c26-bb40-bcf43ccca92a",
    "name": "Pokédex API (local)",
    "description": "All 13 endpoints of docs/api/openapi.yaml.\n\nStart the stack (`docker compose up -d --build`, see README), select the **Pokédex local** environment (or keep the collection variables), and run the folders in order (Runner works too).\n\nCookies and CSRF are handled by the collection scripts: no manual copying. Each run uses a new email; clear the `email` variable to get another one.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Cookie auth + CSRF, done for you (docs/security.md §4.2.1).",
          "// The backend keeps the JWT in the `access_token` cookie and wants the `XSRF-TOKEN` cookie value echoed in the",
          "// `X-XSRF-TOKEN` header on every non-GET request. Values are captured from Set-Cookie (see the test script).",
          "const xsrf = pm.collectionVariables.get('xsrfToken');",
          "const jwt = pm.collectionVariables.get('accessToken');",
          "const cookies = [];",
          "if (xsrf) cookies.push('XSRF-TOKEN=' + xsrf);",
          "if (jwt) cookies.push('access_token=' + jwt);",
          "if (cookies.length) pm.request.headers.upsert({ key: 'Cookie', value: cookies.join('; ') });",
          "if (pm.request.method !== 'GET' && xsrf) pm.request.headers.upsert({ key: 'X-XSRF-TOKEN', value: xsrf });"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Capture fresh cookies from every response: the backend issues a new XSRF-TOKEN after login, logout and writes.",
          "pm.response.headers.each(h => {",
          "  if (h.key.toLowerCase() !== 'set-cookie') return;",
          "  const [pair, ...attrs] = h.value.split(';');",
          "  const i = pair.indexOf('=');",
          "  const name = pair.slice(0, i).trim(), value = pair.slice(i + 1).trim();",
          "  const cleared = !value || attrs.some(a => a.trim().toLowerCase() === 'max-age=0');",
          "  if (name === 'XSRF-TOKEN') pm.collectionVariables.set('xsrfToken', cleared ? '' : value);",
          "  if (name === 'access_token') pm.collectionVariables.set('accessToken', cleared ? '' : value);",
          "});"
        ]
      }
    }
  ],
