        {
          "name": "Update custom attributes",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/collection/{{pokedexId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "collection",
                "{{pokedexId}}"
              ]
            },
            "description": "Full replace of customAttributes. `version` must be the current one (optimistic locking).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customAttributes\": {\n    \"localizedNames\": [\n      {\n        \"lang\": \"ja\",\n        \"value\": \"ピカチュウ\"\n      },\n      {\n        \"lang\": \"es\",\n        \"value\": \"Pikachu\"\n      }\n    ],\n    \"geo\": {\n      \"region\": \"Kanto\",\n      \"habitat\": \"forest\",\n      \"coordinates\": {\n        \"latitude\": 35.68,\n        \"longitude\": 139.69\n      }\n    },\n    \"tags\": [\n      \" Starter \",\n      \"electric\",\n      \"ELECTRIC\"\n    ]\n  },\n  \"version\": {{version}}\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('tags normalized', () => pm.expect(pm.response.json().custom.tags).to.have.members(['starter','electric']));",
                  "pm.collectionVariables.set('staleVersion', pm.collectionVariables.get('version'));",
                  "pm.collectionVariables.set('version', pm.response.json().version);"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// If no CSRF token yet (fresh run, or cleared by login/logout), fetch one first.",
                  "if (!pm.collectionVariables.get('xsrfToken')) {",
                  "  pm.sendRequest({ url: pm.collectionVariables.get('baseUrl') + '/api/v1/auth/csrf', method: 'GET' }, (err, res) => {",
                  "    if (!err) pm.collectionVariables.set('xsrfToken', res.json().token);",
                  "    const x = pm.collectionVariables.get('xsrfToken');",
                  "    pm.request.headers.upsert({ key: 'X-XSRF-TOKEN', value: x });",
                  "    const jwt = pm.collectionVariables.get('accessToken');",
                  "    pm.request.headers.upsert({ key: 'Cookie', value: 'XSRF-TOKEN=' + x + (jwt ? '; access_token=' + jwt : '') });",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
