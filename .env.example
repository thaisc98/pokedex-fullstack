# ─────────────────────────────────────────────────────────────────────────────
# Pokédex: environment template
# Copy to .env and fill in:   cp .env.example .env
# docker compose reads .env from this folder automatically.
# NEVER commit .env (it is git-ignored). Only this template is committed.
# ─────────────────────────────────────────────────────────────────────────────

# Spring profiles: demo = seeded data + Swagger UI · offline = WireMock instead of PokeAPI
SPRING_PROFILES_ACTIVE=demo

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=pokedex
# Host port for the compose Postgres (bound to 127.0.0.1). Change it if 5432 is already in use locally.
POSTGRES_PORT=5432

# Schema owner: used only by Flyway migrations.
# docker compose also uses it as the Postgres container's POSTGRES_USER / POSTGRES_PASSWORD.
FLYWAY_USER=pokedex_owner
FLYWAY_PASSWORD=change-me-owner

# App user: SELECT/INSERT/UPDATE/DELETE only (least privilege, see docs/security.md §4.8)
DB_URL=jdbc:postgresql://postgres:5432/pokedex
DB_USER=pokedex_app
DB_PASSWORD=change-me-app

# ── JWT (see docs/security.md §4.2) ─────────────────────────────────────────
# At least 256 bits. The app refuses to start if this is missing or too short.
# Generate with:  openssl rand -base64 32
JWT_SECRET=
JWT_ISSUER=pokedex-api
JWT_AUDIENCE=pokedex-web

# ── PokeAPI ──────────────────────────────────────────────────────────────────
POKEAPI_BASE_URL=https://pokeapi.co/api/v2

# ── Demo accounts (demo profile only; documented in README) ─────────────────
DEMO_ADMIN_EMAIL=admin@pokedex.local
DEMO_ADMIN_PASSWORD=change-me-demo-admin
DEMO_USER_EMAIL=trainer@pokedex.local
DEMO_USER_PASSWORD=change-me-demo-user

# ── Frontend (Next.js server side only, never NEXT_PUBLIC_) ───────────────────
BACKEND_INTERNAL_URL=http://backend:8080
