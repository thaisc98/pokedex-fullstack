{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:3000/pokemon",
        "http://localhost:3000/pokemon/eevee",
        "http://localhost:3000/login"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--headless=new --no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }],
        "categories:performance": ["warn", { "minScore": 0.85, "aggregationMethod": "median-run" }],
        "categories:best-practices": ["warn", { "minScore": 0.9, "aggregationMethod": "median-run" }],
        "categories:seo": ["warn", { "minScore": 0.9, "aggregationMethod": "median-run" }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "test-results/lighthouse/mobile"
    }
  }
}
