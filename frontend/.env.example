# Next.js frontend: local development outside Docker (npm run dev).
# Copy to .env.local:   cp .env.example .env.local
# Next.js only reads env files from this folder. NEVER commit .env.local.

# Where the Next.js server reaches the Spring API (rewrites /api/* and Server Components).
# Server side only. Do NOT prefix with NEXT_PUBLIC_ (those are shipped to the browser).
BACKEND_INTERNAL_URL=http://localhost:8080
