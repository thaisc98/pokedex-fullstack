{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./mvnw *)",
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npm ci)",
      "Bash(npx playwright test *)",
      "Bash(npx tsc --noEmit *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)",
      "Bash(docker compose up *)",
      "Bash(docker compose down *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "mcp__heroui-react__*",
      "WebFetch(domain:heroui.com)",
      "WebFetch(domain:docs.spring.io)",
      "WebFetch(domain:nextjs.org)",
      "WebFetch(domain:redux-toolkit.js.org)",
      "WebFetch(domain:playwright.dev)",
      "WebFetch(domain:java.testcontainers.org)",
      "WebFetch(domain:pokeapi.co)",
      "WebFetch(domain:cheatsheetseries.owasp.org)",
      "WebFetch(domain:owasp.org)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm uninstall *)",
      "Bash(docker compose down -v *)",
      "Bash(rm -rf *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(!.env.example)",
      "Read(*.pem)",
      "Read(*.key)",
      "Read(*.p12)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.m2/settings.xml)",
      "Read(~/.npmrc)",
      "Bash(git push *--force*)",
      "Bash(git push -f *)",
      "Bash(git push * -f *)",
      "Bash(git push * -f)"
    ]
  }
}
